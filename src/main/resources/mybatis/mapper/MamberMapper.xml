<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.insightcrew.repositary.MemberRepositary">

	<!-- enum 매핑 포함. db테이블 값. -->
	<resultMap id="memberResultMap" type="com.insightcrew.domain.member.vo.MemberVo">
		<id property="pkId" column="member_id"/>
		<result property="userid" column="login_id"/>
		<result property="password" column="password"/>
		<result property="name" column="name"/>
		<result property="nickname" column="nickname"/>
		<result property="role" column="role"/>
		<result property="status" column="status"/>
		<result property="indate" column="in_date"/>
		<result property="outdate" column="out_date"/>
	</resultMap>
	
	<!-- 로그인 아이디 찾는 쿼리문 -->
	<select id="findByUserid" parameterType="string" resultMap="memberResultMap">
	SELECT
		member_id,
        login_id,
        password,
        name,
        nickname,
        role,
        status,
        in_date,
        out_date
		FROM member
		WHERE login_id=#{userid}
		AND status = 'ACTIVE';
	</select>
	
	<!-- 닉네임 찾는 쿼리문 -->
	<select id="findByNickname" resultType="memberResultMap">
		SELECT
			member_id,
	        login_id,
	        password,
	        name,
	        nickname,
	        role,
	        status,
	        in_date,
	        out_date
		FROM member
		WHERE nickname=#{nickname}
		AND status = 'ACTIVE';
	</select>
	
	<!-- 회원가입:가입정보 넣기-->
	<insert id="insertMember">
		INSERT INTO member (
			member_id,
	        login_id,
	        password,
	        name,
	        nickname,
	        role,
	        status,
	        in_date,
	        out_date
		)
		VALUE(#{userid},#{password},#{name},#{nickname})
		AND role = 'USER', status = 'ACTIVE';
	</insert>
</mapper>