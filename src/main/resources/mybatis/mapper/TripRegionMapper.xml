<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.insightcrew.repository.TripRegionMapper">

    <!-- 시/도 + 시군구 매핑 조회 -->
    <select id="findBySidoAndSigungu"
            resultType="com.insightcrew.domain.trip.vo.RegionVo">
        SELECT 
            id,
            sido,
            sigungu,
            nx,
            ny
        FROM region
        WHERE sido = #{sido}
        AND (
            sigungu = #{sigungu}
            OR (sigungu IS NULL AND #{sigungu} IS NULL)
        )
        LIMIT 1
    </select>

    <!-- region_id 단일 조회 -->
    <select id="findById"
            resultType="com.insightcrew.domain.trip.vo.RegionVo">
        SELECT 
            id,
            sido,
            sigungu,
            nx,
            ny
        FROM region
        WHERE id = #{id}
    </select>
    
    <select id="findDistinctSido"
        	resultType="java.lang.String">
    	SELECT DISTINCT sido
    	FROM region
    	WHERE sido IS NOT NULL
    	ORDER BY sido ASC
	</select>

	<select id="findSigunguBySido"
        	resultType="java.lang.String">
    	SELECT DISTINCT sigungu
    	FROM region
   		WHERE sido = #{sido}
    	AND sigungu IS NOT NULL
    	ORDER BY sigungu ASC
	</select>

    <!-- 전체 지역 조회 (날씨 업데이트 배치용) -->
    <select id="findAll"
            resultType="com.insightcrew.domain.trip.vo.RegionVo">
        SELECT 
            id,
            sido,
            sigungu,
            nx,
            ny
        FROM region
        ORDER BY id ASC
    </select>

</mapper>
