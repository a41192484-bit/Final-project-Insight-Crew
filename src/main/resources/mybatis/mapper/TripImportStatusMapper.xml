<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.insightcrew.repository.TripImportStatusMapper">

    <select id="getImportStatus" resultType="map">
        SELECT * FROM trip_import_status WHERE id = 1
    </select>

    <update id="updateImportStatus">
        UPDATE trip_import_status
        SET content_type_id = #{contentTypeId},
            area_code = #{areaCode},
            last_page = #{lastPage}
        WHERE id = 1
    </update>

</mapper>